{
  "expo": {
    "name": "Nomli",
    "slug": "nomli",
    "scheme": "nomli",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon_ios_nomli.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/nomli-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3ECDC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medy.nomli",
      "buildNumber": "12",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/nomli-logo.png",
        "backgroundColor": "#F3ECDC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.medy.nomli"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nous avons besoin de votre position pour afficher les autres utilisateurs autour de vous sur la carte."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à vos photos pour choisir une photo de profil.",
          "cameraPermission": "L'application a besoin d'accéder à votre caméra pour prendre une photo de profil."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cf139d4-cbe6-4e6e-b592-5e3b7d76aff1"
      }
    },
    "owner": "medy75"
  }
}
